{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Launch", // Display name in the dropdown
            "type": "cppdbg",       // Debugger type for C/C++
            "request": "launch",    // We want to launch the program, not attach
            "program": "${workspaceFolder}/build/src/DigiviceSim.exe", // <<< CRITICAL: Path to your executable! CHECK THIS!
            "args": [],             // Any command-line arguments (we don't need any)
            "stopAtEntry": false,   // Set to true if you want it to pause right at the start
            "cwd": "${workspaceFolder}", // Current working directory when running
            "environment": [],
            "externalConsole": false, // Run in VS Code's integrated Debug Console
            "MIMode": "gdb",          // Specify GDB as the debugger
            "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe", // <<< Path to your GDB. CHECK THIS!
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            // Optional: Add this if CMake didn't automatically create a preLaunchTask
            // "preLaunchTask": "CMake: build"
        }
    ]
}